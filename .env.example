# Copy to .env. Never commit .env or enter secrets in GitHub.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# hub for new NAVER Cloud API HUB credentials; legacy only for existing Developers keys.
NAVER_API_MODE=hub
YOUTUBE_API_KEY=
# Instagram Login: professional account and content publish permission required.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_API_VERSION=v24.0
# Public HTTPS origin serving ONLY data/media, e.g. your dedicated media host.
PUBLIC_MEDIA_BASE_URL=
FONT_PATH=C:/Windows/Fonts/malgun.ttf
# Optional card AI images via KIE AI. Model input formats differ; nano-banana-2 is the tested default.
KIE_API_KEY=
KIE_IMAGE_MODEL=nano-banana-2
KIE_IMAGE_RESOLUTION=1K
# Selected AI connection. Personal credentials are preserved when semyung is selected.
AI_PROVIDER=openai
SEMYUNG_API_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
SEMYUNG_API_KEY=
SEMYUNG_TEXT_MODEL=gpt-5.4-mini
SEMYUNG_REVIEW_MODEL=gpt-5.4-mini
SEMYUNG_FRAME_MODEL=gpt-5.4-mini
