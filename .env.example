# Copy to .env. Never commit .env or enter secrets in GitHub.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Instagram Login: professional account and content publish permission required.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
